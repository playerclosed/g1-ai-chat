# Mentra CLI API Key (von console.mentraglass.com/cli-keys)
MENTRA_API_KEY=YOUR_MENTRA_CLI_API_KEY_HERE

# App Package Name
PACKAGE_NAME=com.player.codewords-ai-chat

# OpenAI API Key (besorge dir einen unter platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Port (Railway setzt automatisch)
PORT=3000